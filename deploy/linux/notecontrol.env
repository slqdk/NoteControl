# /etc/notecontrol/notecontrol.env
#
# Read by systemd (EnvironmentFile= in notecontrol.service). install.sh
# copies this template here on first install only and never overwrites
# it afterwards, so local edits survive updates.
#
# Keys are ASP.NET configuration keys with ':' written as '__'
# (Network:Port -> Network__Port, list item 0 -> __0).
#
# Precedence (lowest to highest):
#   /opt/notecontrol/app/appsettings.json   (replaced on every install)
#   this file
#   /var/lib/notecontrol/.server/config.json (written by the admin UI)
#
# After editing: systemctl restart notecontrol

# Listen on all interfaces so Nginx Proxy Manager (another host) can
# reach Kestrel. Set to false for loopback-only.
Network__ExposeOnLan=true
Network__Port=8080

# IP (or CIDR) of the reverse proxy. Without it, every client appears
# to come from the proxy's address and all users share one login
# throttle bucket. Add more with __1, __2, ...
#Network__TrustedProxies__0=192.168.1.10

# Public URL used in outbound email links.
#Network__PublicUrl=https://notes.example.dk

# Password for the bootstrap admin created on first start (only used
# when the user table is empty). If unset, a random password is
# generated and written to the log:
#   journalctl -u notecontrol | grep "BOOTSTRAP ADMIN"
#Auth__BootstrapAdmin__Password=
